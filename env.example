# Environment variables for the BillSheba backend (Coolify: set these on the web, worker AND cron apps).
# Copy to .env for local use. Never commit the real values.

# --- Django ---
DEBUG=False
SECRET_KEY=generate-a-long-random-string
# Backend lives at api.billsheba.com. Add the internal Coolify service name too if the frontend calls it
# over the internal network (e.g. API_URL=http://backend:8000 -> add "backend").
DJANGO_ALLOWED_HOSTS=api.billsheba.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://billsheba.com,https://api.billsheba.com
# The browser only talks to billsheba.com (Next.js proxies /api/v1), so CORS only needs the frontend.
CORS_ALLOWED_ORIGINS=https://billsheba.com

# --- Database / queue ---
# Production must be Postgres: web, worker and cron are separate containers and cannot share sqlite.
DATABASE_URL=postgres://user:password@host:5432/billsheba
CELERY_BROKER_URL=redis://host:6379/0

# --- Public addresses ---
# Public address of the FRONTEND. bKash redirects customers back here and the callbacks are
# {PUBLIC_BASE_URL}/api/v1/.../callback, which the Next.js proxy forwards to this backend.
PUBLIC_BASE_URL=https://billsheba.com
# Where collectstatic files are served from (your Coolify static server).
STATIC_URL=https://static-django.billsheba.com/

# --- Secrets ---
# Separate key for encrypting router/bKash credentials (defaults to SECRET_KEY). BACK THIS UP: if it is
# lost, saved router and bKash credentials cannot be decrypted.
# FIELD_ENCRYPTION_KEY=

# --- SMS gateway (platform-owned, used for every ISP) ---
SMS_API_KEY=
SMS_SENDER_ID=

# --- Platform subscription fee (where ISPs send their payment) ---
PLATFORM_BKASH_NUMBER=
PLATFORM_NAGAD_NUMBER=
PLATFORM_ROCKET_NUMBER=
# Platform's own bKash MERCHANT credentials (ISP subscription fees land here).
# Each ISP adds its own merchant credentials in Settings -> bKash for customer bills.
PLATFORM_BKASH_APP_KEY=
PLATFORM_BKASH_APP_SECRET=
PLATFORM_BKASH_USERNAME=
PLATFORM_BKASH_PASSWORD=
PLATFORM_BKASH_SANDBOX=False

# --- Optional ---
DEFAULT_TRIAL_DAYS=14
MIKROTIK_VERIFY_SSL=False
MIKROTIK_REQUEST_TIMEOUT=15
ENABLE_DOC=False
ENABLE_SILK=False
